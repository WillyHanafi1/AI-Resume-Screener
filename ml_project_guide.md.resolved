### Phase 5: Streamlit Demo UI (Hari 11-12)

#### Step 5.1 — Interactive Demo (`app/app.py`)

```python
import streamlit as st
import joblib
from src.pytorch_pipeline import SemanticMatcher
from src.feature_engineering import build_features
from src.data_processing import clean_text

st.set_page_config(page_title="AI Resume Screener", layout="wide")
st.title("🎯 AI Resume Screening & Matching System")

# Load models
@st.cache_resource
def load_models():
    sklearn_model = joblib.load('models/best_sklearn_model.pkl')
    semantic_matcher = SemanticMatcher()
    return sklearn_model, semantic_matcher

sklearn_model, semantic_matcher = load_models()

# Sidebar
method = st.sidebar.radio("Matching Method", ["ML (scikit-learn)", "DL (Sentence Transformers)", "Hybrid"])

# Main UI
col1, col2 = st.columns(2)

with col1:
    st.subheader("📄 Job Description")
    jd_text = st.text_area("Paste job description here", height=300)

with col2:
    st.subheader("📋 Resume(s)")
    uploaded_files = st.file_uploader("Upload resume(s)", accept_multiple_files=True, type=['txt', 'pdf'])

if st.button("🔍 Analyze & Rank") and jd_text and uploaded_files:
    # Process each resume
    results = []
    for file in uploaded_files:
        resume_text = file.read().decode('utf-8')
        resume_clean = clean_text(resume_text)
        jd_clean = clean_text(jd_text)
        
        # scikit-learn score
        features = build_features(resume_clean, jd_clean)
        ml_score = sklearn_model.predict_proba([list(features.values())])[0][1] * 100
        
        # Semantic score
        semantic_score = semantic_matcher.compute_similarity(resume_clean, jd_clean) * 100
        
        # Hybrid
        hybrid_score = (ml_score * 0.4) + (semantic_score * 0.6)
        
        results.append({
            'file': file.name,
            'ml_score': ml_score,
            'semantic_score': semantic_score,
            'hybrid_score': hybrid_score,
            'skills': features,
        })
    
    # Display ranked results
    results.sort(key=lambda x: x['hybrid_score'], reverse=True)
    
    for i, r in enumerate(results, 1):
        with st.expander(f"#{i} — {r['file']} (Score: {r['hybrid_score']:.1f}/100)"):
            col_a, col_b, col_c = st.columns(3)
            col_a.metric("ML Score", f"{r['ml_score']:.1f}")
            col_b.metric("Semantic Score", f"{r['semantic_score']:.1f}")
            col_c.metric("Hybrid Score", f"{r['hybrid_score']:.1f}")
            
            st.json(r['skills'])
```

